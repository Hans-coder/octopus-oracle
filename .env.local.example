# Football Data API (https://www.football-data.org)
# 註冊免費帳號取得 token (10 req/min, 100 req/day 免費額度)
FOOTBALL_DATA_API_TOKEN=

# 競賽 ID: WC = 世界杯
FOOTBALL_COMPETITION_ID=WC

# Cron Job 安全金鑰 (Vercel Cron 需驗證)
CRON_SECRET=change-me-to-a-random-string

# 若無 API token，啟用 mock 模式 (true/false)
USE_MOCK_DATA=true
