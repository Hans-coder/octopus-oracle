# ─────────────────────────────────────────
# Octopus Oracle environment variables
#
# This project runs without mock fallback.
# If no LLM provider key is set, AI analysis is disabled.
# ─────────────────────────────────────────

# ── 本地方案（免費零成本，推薦）─────────────
# Ollama（本地 LLM，完全免費）
# 1. 下載 Ollama: https://ollama.ai
# 2. 安裝後運行: ollama run llama2  (或 mistral, neural-chat)
# 3. 設置以下環境變數:
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama2  # 可選，預設 llama2 (mistral 更快)
# OLLAMA_BASE_URL=http://localhost:11434  # 可選

# ── 免費方案 ───────────────────────────────
# Groq（推薦 ⭐ 免費，速度極快，基於 Llama）
# 取得 key：https://console.groq.com
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.1-8b-instant  # 可選

# Google Gemini（完全免費，無需信用卡，但 API 模型支援有限）
# 取得 key：https://aistudio.google.com → Get API key
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-pro  # 可選，試試 gemini-pro 或 gemini-pro-vision

# ── 付費方案 ───────────────────────────────
# OpenAI（需儲值，建議 $5 USD）
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-4o-mini

# Anthropic
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Redis 快取（可選，Vercel 部署推薦）─────
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── 其他 ───────────────────────────────────
# LLM_CACHE_TTL_SECONDS=1800
# CRON_SECRET=
