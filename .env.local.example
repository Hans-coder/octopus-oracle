# ─────────────────────────────────────────
# 章魚哥神諭 · 環境變數範例
# 複製為 .env.local 再填值
# ─────────────────────────────────────────

# ─── 賽程資料 ───
# https://www.football-data.org/ 申請免費 token（10 req/min, 100/day）
FOOTBALL_DATA_API_TOKEN=

# 競賽 ID：WC = 世界杯
FOOTBALL_COMPETITION_ID=WC

# true 強制用 mock；false 或不設則嘗試呼叫真實 API
USE_MOCK_DATA=true

# ─── 章魚神諭官 · LLM ───
# 三選一：mock（預設，零成本）/ openai / anthropic
LLM_PROVIDER=mock

# 用 OpenAI 時必填（不填會自動退回 mock）
OPENAI_API_KEY=
# 預設 gpt-4o-mini（便宜）
OPENAI_MODEL=gpt-4o-mini

# 用 Anthropic 時必填
ANTHROPIC_API_KEY=
# 預設 claude-haiku-4-5（便宜）
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ─── Vercel Cron ───
# 設一組亂數字串保護 cron endpoint
CRON_SECRET=change-me-to-a-random-string
